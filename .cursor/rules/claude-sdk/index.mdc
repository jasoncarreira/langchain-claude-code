    # Core APIs
    query,
    ClaudeSDKClient,
    ClaudeAgentOptions,
    # Message types
    AssistantMessage,
    UserMessage,
    SystemMessage,
    ResultMessage,
    # Content blocks
    TextBlock,
    ToolUseBlock,
    ToolResultBlock,
    # Tools
    tool,
    create_sdk_mcp_server,
    # Hooks
    HookMatcher,
    # Agents
    AgentDefinition,
    # Errors
    ClaudeSDKError,
    CLINotFoundError,
    ProcessError,
)
```
